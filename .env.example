# ==============================================================================
# CertiFlow Environment Configuration
# ==============================================================================

# Project Metadata
PROJECT_NAME="CertiFlow - Bulk Certificate Generation & Tracking System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration:
# Default: Local SQLite (Zero-setup out of the box)
DATABASE_URL="sqlite:///./certiflow.db"

# PostgreSQL Configuration (Uncomment to use PostgreSQL):
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/certiflow_db"

# Storage Configuration (Path to local directory storing generated PDF certificates)
STORAGE_DIR="./storage/certificates"

# Maximum Batch Size (Safety guard against uncontrolled resource consumption)
MAX_BATCH_SIZE=500

# CORS Allowed Origins (Comma-separated list or * for local dev)
CORS_ORIGINS="*"
